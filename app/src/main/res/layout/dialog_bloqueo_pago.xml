<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F0F2F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dialog_card"
        android:padding="24dp"
        android:elevation="6dp">

        <!-- Header Icon / Emoji -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="36sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvDialogTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suscripción Requerida"
            android:textColor="#1A237E"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvDialogMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activa tu suscripción mensual de S/ 5.00 para disfrutar del Asistente de Pagos sin interrupciones."
            android:textColor="#616161"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- QR de Pago Yape con marco elegante -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivQrPago"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:src="@drawable/qr_pago"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="QR de Pago Yape"/>
        </LinearLayout>

        <!-- Campo para Ingresar Nombre de Yape -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F3E5F5"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa tu Nombre exacto con asterisco (*):"
                android:textColor="#4A148C"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNombreTitular"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej: Luis Ort*"
                android:textColor="#000000"
                android:textColorHint="#9E9E9E"
                android:textSize="15sp"
                android:background="#FFFFFF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:singleLine="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Debe ser idéntico al comprobante (Ej: Luis Ort*)"
                android:textColor="#7B1FA2"
                android:textSize="11sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Referencia oculta para el código de dispositivo -->
        <TextView
            android:id="@+id/tvCodigoClienteDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="NPD-0000"/>

        <!-- Botón Verificar Pago (Principal) -->
        <Button
            android:id="@+id/btnVerificarPago"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🔄 Ya Pagué / Verificar Pago"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:elevation="2dp"
            android:layout_marginBottom="10dp"/>

        <!-- Botón WhatsApp (Contacto General) -->
        <Button
            android:id="@+id/btnWhatsapp"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="💬 Contactar por WhatsApp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="10dp"/>

        <!-- Botón Cerrar App -->
        <Button
            android:id="@+id/btnCerrarApp"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Cerrar App"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>

    </LinearLayout>
</ScrollView>